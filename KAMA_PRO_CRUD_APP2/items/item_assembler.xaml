<UserControl x:Class="KAMA_PRO_CRUD_APP.items.item_assembler"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KAMA_PRO_CRUD_APP.items"
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="477">

    <UserControl.Resources>
    <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/style/styles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
</UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="112*"/>
            <ColumnDefinition Width="293*"/>
            <ColumnDefinition Width="72*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#ffffff" CornerRadius="20" Margin="5,5,5,5"  Grid.ColumnSpan="3">

        </Border>

        <Border Margin="14,14,14,14" Background="White" CornerRadius="14">
            <Grid Grid.Column="0">
                <Image Margin="0,0,0,3" Height="85" Width="85" Source="/imgs/avatars/mechanic-body.png"/>
                <Image Height="65" Width="65" Margin="0,-15,0,0" Source="/imgs/moai.png"/>
            </Grid>
        </Border>

        <StackPanel Grid.Column="1" Margin="0,-10,0,0">
            <Grid>
                <Label x:Name="fullname_tb" Margin="0,15,0,-5"  Content="тестов тест тестович" FontWeight="Bold"/>
                <TextBox x:Name="fullname_edit" Height="20" Margin="0,20,0,-5" Width="200" HorizontalAlignment="Left" Text="тестов тест тестович" Visibility="Hidden"/>
            </Grid>
            
            <StackPanel Orientation="Horizontal">
                <Label Margin="0,0,0,-5" Content="имя пользователя:"/>
                <Grid>
                    <Label x:Name="username_tb" Content="тест"/>
                    <TextBox x:Name="username_edit" HorizontalAlignment="Left" Height="20" Width="150" Margin="0,5,0,0" Text="тестов тест тестович" Visibility="Hidden"/>
                </Grid>
                
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Label Margin="0,0,0,-5" Content="роль пользователя:"/>
                <Grid>
                    <Label x:Name="role_tb" Content="для теста"/>
                    <ComboBox x:Name="role_edit" HorizontalAlignment="Left" Height="20" Width="150" Margin="0,5,0,0" Visibility="Hidden"/>
                </Grid>
                
            </StackPanel>
        </StackPanel>
        <Grid Grid.Column="2">

            <Grid Height="40" VerticalAlignment="Top">
                <Image Source="/imgs/cross.png" Margin="0,10,0,0" Width="25" Height="25"/>
                <Button Click="delete_user" Margin="0,10,0,0" Width="25" Height="25" Opacity="0" Cursor="Hand"/>
            </Grid>

            <Grid Height="40" VerticalAlignment="Bottom">
                <!--pencil-->
                <Grid x:Name="pencil">
                    <Image Source="/imgs/pencil.png"  Width="25" Height="25"/>
                    <Button Click="edit_user" Margin="0,0,0,0" Width="25" Height="25" Opacity="0" Cursor="Hand"/>
                </Grid>
                <!--confirm-->
                <Grid x:Name="confirm" Visibility="Hidden">
                    <Image Source="/imgs/submit.png"  Width="25" Height="25"/>
                    <Button Click="confirm_btn" Margin="0,0,0,0" Width="25" Height="25" Opacity="0" Cursor="Hand"/>
                </Grid>
            </Grid>
            
        </Grid>
    </Grid>
</UserControl>
