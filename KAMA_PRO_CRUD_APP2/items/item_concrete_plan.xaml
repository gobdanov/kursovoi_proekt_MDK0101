<UserControl x:Class="KAMA_PRO_CRUD_APP2.items.item_concrete_plan"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KAMA_PRO_CRUD_APP2.items"
             mc:Ignorable="d">
<Grid>
        <Grid Grid.Row="1" Background="Beige" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Label Content="название" x:Name="Name" Grid.Column="0"/>
            <Label Content="шильд" x:Name="Nameplate" Grid.Column="1"/>
            <Label Content="готов" x:Name="Is_Ready" Grid.Column="2"/>
            <Label Content="сборщики" x:Name="Assemblers" Grid.Column="3"/>
        </Grid>
    </Grid>
</UserControl>
