<UserControl x:Class="KAMA_PRO_CRUD_APP.items.Item_plan"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KAMA_PRO_CRUD_APP.items"
             mc:Ignorable="d" 
             d:DesignHeight="60" d:DesignWidth="274">
    <Grid>
        <Border Background="#ffffff" CornerRadius="20" Margin="5,5,5,5"/>
        <Grid Margin="5,5,5,5">
            <Label x:Name="city_tb" Content="пермь" Margin="20,0,0,0" FontSize="20"  VerticalAlignment="Center"/>
            <Label x:Name="all_trailers_tb" Content="всего: 48" Margin="0,0,50,0"  FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Top"/>
            <Label x:Name="ready_trailers_tb" Content="собрано: 24" Margin="0,0,50,0" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
            <Image Source="/imgs/cross.png" HorizontalAlignment="Right" Width="30" Margin="0,0,7,0"/>
        </Grid>

        <Button Margin="5,5,5,5" Cursor="Hand" Click="goto_plan" Opacity="0"/>
        <Button HorizontalAlignment="Right" Cursor="Hand" Click="delete_plan" Width="50" Margin="0,0,7,0" Opacity="0"/>

    </Grid>
</UserControl>
