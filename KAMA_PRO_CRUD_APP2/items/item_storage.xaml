<UserControl x:Class="KAMA_PRO_CRUD_APP.items.item_storage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KAMA_PRO_CRUD_APP.items"
             mc:Ignorable="d"  d:DesignWidth="400">
    <Grid>
        <Grid Grid.Row="1" Background="Beige" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Label VerticalAlignment="Center" Content="название" x:Name="name" Grid.Column="0"/>
            <Label VerticalAlignment="Center"  Content="кол-во" x:Name="count" Grid.Column="1"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Image Source="/imgs/minus.png" Height="20" Width="20"/>
                <Image Source="/imgs/plus.png" Height="20" Width="20"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Height="20" Width="20" Opacity="0" Click="minus" Cursor="Hand"/>
                <Button Height="20" Width="20" Opacity="0" Click="plus" Cursor="Hand"/>
            </StackPanel>
        </Grid>




        <!--
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Label Content="test1" x:Name="name" HorizontalAlignment="Left" Grid.Column="0" />
        <Label Content="test1" x:Name="count" HorizontalAlignment="Left" Grid.Column="1" />
        

        
        -->
    </Grid>
</UserControl>
