<UserControl x:Class="KAMA_PRO_CRUD_APP2.items.item_concrete_assemblage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:KAMA_PRO_CRUD_APP2.items"
             mc:Ignorable="d"
             d:DesignWidth="447">
    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Прицеп -->
        <Label VerticalAlignment="Center"
               Content="прицеп"
               x:Name="Trailer"
               Grid.Column="0"
               FontSize="14"
               Foreground="Black"
               Padding="10,0,0,0"/>

        <!-- Сборщики -->
        <Label VerticalAlignment="Center"
               Content="сборщики"
               x:Name="Assemblers"
               Grid.Column="1"
               FontSize="14"
               Foreground="#666666"
               Padding="10,0,0,0"/>

        <!-- Комментарии -->
        <Label VerticalAlignment="Center"
               Content="комментарии"
               x:Name="Comments"
               Grid.Column="2"
               FontSize="14"
               Foreground="#666666"
               Padding="10,0,0,0"/>

        <!-- План -->
        <Label VerticalAlignment="Center"
               Content="план"
               x:Name="Plan"
               Grid.Column="3"
               FontSize="14"
               Foreground="#666666"
               Padding="10,0,0,0"/>

        <!-- Шильды -->
        <Label VerticalAlignment="Center"
               Content="шильды"
               x:Name="Nameplate"
               Grid.Column="4"
               FontSize="14"
               Foreground="#666666"
               Padding="10,0,0,0"/>

        <!-- Действия -->
        <StackPanel Grid.Column="5"
                    Margin="10,0,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
            <Grid x:Name="delete_assemblage_grid" Margin="2,0">
                <Border Background="#F0F0F0"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        CornerRadius="10"
                        Height="28" Width="28">
                    <Image Source="/imgs/clear.png"
                           Width="20" Height="20"/>
                </Border>

                <Button Opacity="0"
                        Cursor="Hand"
                        Height="28" Width="28"
                        Click="delete_concrete_assemblage"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>