<Page x:Class="KAMA_PRO_CRUD_APP2.pages.subpages.Page_Concrete_Assemblage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:KAMA_PRO_CRUD_APP2.pages.subpages"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="487"
      Title="Page_Concrete_Assemblage">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Column="0" Grid.Row="0">
            <Image Source="/imgs/left-arrow.png" Margin="0,4,0,0"  Height="20" Width="20" VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Label Content="вернуться" Margin="20,0,0,0"/>
        </Grid>

        <Button Click="goto_back" Grid.Column="0" Grid.Row="0" Margin="0,0,80,45" Opacity="0" Cursor="Hand"/>

        <StackPanel Grid.Column="0" Grid.Row="0">
            <Label Content="сборка за конкретную дату" Margin="0,20,0,0" HorizontalAlignment="Left"  VerticalAlignment="Top" FontWeight="Bold" FontSize="14"/>
        </StackPanel>

        <Grid Grid.Row="1" Background="AliceBlue" Margin="20,0,20,0" Height="30" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Label Content="прицеп" x:Name="Trailer" Grid.Column="0"/>
            <Label Content="сборщики" x:Name="Assemblers" Grid.Column="1"/>
            <Label Content="комментарии" x:Name="Comments" Grid.Column="2"/>
            <Label Content="план" x:Name="Plan" Grid.Column="3"/>
            <Label Content="шильды" x:Name="Nameplate" Grid.Column="4"/>
            <Label Content="фото" x:Name="Photo" Grid.Column="5"/>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="20,30,20,30">
            <StackPanel x:Name="parent" />
        </ScrollViewer>
    </Grid>
</Page>
