<Page x:Class="KAMA_PRO_CRUD_APP2.pages.subpages.Page_Concrete_Plan"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:KAMA_PRO_CRUD_APP2.pages.subpages"
      mc:Ignorable="d"
      d:DesignHeight="550" d:DesignWidth="487"
      Title="Page_Concrete_Plan">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>


        <Grid Grid.Column="0" Grid.Row="0" Margin="5,0,0,0">
            <Image Source="/imgs/left-arrow.png" Margin="0,4,0,0"  Height="20" Width="20" VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Label Content="вернуться" Margin="20,0,0,0"/>
        </Grid>

        <Button Click="goto_back" Grid.Column="0" Grid.Row="0" Margin="5,0,80,45" Opacity="0" Cursor="Hand"/>

        <StackPanel Grid.Column="0" Grid.Row="0">
            <Label Content="название плана" x:Name="plan_name" Margin="0,30,0,0" HorizontalAlignment="Left"  VerticalAlignment="Top" FontWeight="Bold" FontSize="14"/>
        </StackPanel>

        <!-- ЛЕГЕНДА ТАБЛИЦЫ -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                Margin="20,0,20,0"
                Height="30"
                VerticalAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Label Content="название"
                       x:Name="Name"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#666666"
                       Padding="10,0"/>

                <Label Content="шильд"
                       x:Name="Nameplate"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#666666"
                       Padding="10,0"/>

                <Label Content="готов"
                       x:Name="Is_Ready"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#666666"
                       Padding="10,0"/>

                <Label Content="сборщики"
                       x:Name="Assemblers"
                       Grid.Column="3"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#666666"
                       Padding="10,0"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="20,30,20,30">
            <StackPanel x:Name="parent" />
        </ScrollViewer>



    </Grid>
</Page>