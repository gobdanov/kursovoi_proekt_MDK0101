<Page x:Class="KAMA_PRO_CRUD_APP2.pages.subpages.Page_Add_Component"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:KAMA_PRO_CRUD_APP2.pages.subpages"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="487"
      Title="Page_Add_Component">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/style/styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Column="0" Grid.Row="0" Margin="5,0,0,0">
            <Image Source="/imgs/left-arrow.png" Margin="0,4,0,0"  Height="20" Width="20" VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <Label Content="вернуться" Margin="20,0,0,0"/>
        </Grid>

        <Button Click="goto_back" Grid.Column="0" Grid.Row="0" Margin="5,0,80,45" Opacity="0" Cursor="Hand"/>

        <StackPanel Grid.Column="0" Grid.Row="0">
            <Label Content="добавить компонент" Margin="0,30,0,0" HorizontalAlignment="Left"  VerticalAlignment="Top" FontWeight="Bold" FontSize="14"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="20,0,0,0">
            <Label Content="укажите имя:" FontSize="14"/>
            <Grid>
                <Image Source="/imgs/id_person.png" Height="30" HorizontalAlignment="Left"/>
                <TextBox x:Name="name_tb" Margin="50,0,30,0" FontSize="14" Style="{StaticResource MyTextBoxStyle}"/>
            </Grid>

            <Label Content="укажите кол-во:" FontSize="14"/>
            <Grid>
                <Image Source="/imgs/bust.png" Height="30" HorizontalAlignment="Left"/>
                <TextBox x:Name="quantity_tb" Margin="50,0,30,0" FontSize="14" Style="{StaticResource MyTextBoxStyle}"/>
            </Grid>
            
            <Button Click="add_component" HorizontalAlignment="Center" VerticalAlignment="Bottom" Grid.Row="2" Width="175" Height="30" Margin="0,30,0,30 " Content="добавить" Style="{StaticResource MyButtonStyle}"/>

        </StackPanel>

    </Grid>
</Page>
