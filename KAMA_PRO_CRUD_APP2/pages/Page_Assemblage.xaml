<Page x:Class="KAMA_PRO_CRUD_APP.pages.Page_Assemblage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:KAMA_PRO_CRUD_APP.pages"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="487"
      Title="Page_Assemblage">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/style/styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="75*"/>
            <RowDefinition Height="75*"/>
            <RowDefinition Height="75*"/>
            <RowDefinition Height="30*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="288*"/>
            <ColumnDefinition Width="199*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,3">
            <Label Content="список сборок" Margin="0,20,0,0" HorizontalAlignment="Left"  VerticalAlignment="Top" FontWeight="Bold" FontSize="14"/>
            <Label Content="" x:Name="type_of_filtration" Foreground="#FFB2B2B2" HorizontalAlignment="Left"  VerticalAlignment="Top"  FontSize="11"/>
        </StackPanel>
        <Border Background="#f0f0f0" CornerRadius="20" Margin="5,5,5,5" Grid.Column="0" Grid.Row="1"  Grid.RowSpan="3">

        </Border>
        <ScrollViewer Margin="0,5,0,5" Grid.Column="0" Grid.Row="1"  Grid.RowSpan="3">
            <StackPanel Margin="15,15,15,15" x:Name="parent_Border">

            </StackPanel>
        </ScrollViewer>
        <Button Grid.Column="1" Content="добавить" Click="goto_Add_Assemblage" x:Name="goto_Add_Assemblage_btn" Style="{StaticResource MyButtonStyle}" HorizontalAlignment="Center" Margin="0,10,0,0" Grid.Row="1" VerticalAlignment="Top" Width="112" Height="30"/>
        <StackPanel Grid.Column="1" Grid.Row="1" Grid.RowSpan="4" Margin="0,141,0,56">
            <Label Content="поиск по:" HorizontalAlignment="Left" Grid.Row="2" VerticalAlignment="Top"/>
            <Label Content="шильдам" HorizontalAlignment="Left" Grid.Row="2" VerticalAlignment="Top" Margin="0,-5,0,0"/>
            <Border BorderBrush="#ACACAC" Background="#EAEAEA" BorderThickness="1" Height="30" CornerRadius="15" Margin="5,0,5,0">
                <StackPanel Orientation="Horizontal">
                    <Label Content="EAV90920" Margin="5,0,0,0"/>
                    <TextBox Margin="-4,0,0,0" Width="15" VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="osnost"/>
                    <Label Margin="-4,0,0,0" Content="T"/>
                    <TextBox Margin="-4,0,0,0" Text="" Width="40" VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="t0_" KeyDown="model_KeyDown"/>
                </StackPanel>
            </Border>

            <Label Content="дате" HorizontalAlignment="Left" Grid.Row="2" VerticalAlignment="Top"/>
            <DatePicker Margin="5,0" SelectedDateChanged="DatePicker_SelectedDateChanged" x:Name="Date_"/>
            <Label Content="прицепам" HorizontalAlignment="Left" Grid.Row="2" VerticalAlignment="Top"/>
            <ComboBox Margin="5,0"  x:Name="cmbbx_trlr" SelectionChanged="Combobox_SelectedDateChanged" Style="{StaticResource MyComboBoxStyle}"/>
            <TextBlock  Text="работает только один тип фильтрации" TextWrapping="WrapWithOverflow" TextAlignment="Center" FontSize="11" Margin="0,5,0,0"  Grid.Row="2" Foreground="#FFB2B2B2"/>
        </StackPanel>

    </Grid>
</Page>
