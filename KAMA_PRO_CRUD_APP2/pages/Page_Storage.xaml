<Page x:Class="KAMA_PRO_CRUD_APP.pages.Page_Storage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:KAMA_PRO_CRUD_APP.pages"
      mc:Ignorable="d"
      d:DesignHeight="550" d:DesignWidth="487"
      Title="Page_Storage">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/style/styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="13*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>



        <StackPanel Grid.Column="0" Grid.Row="0">
            <Label Content="склад" x:Name="plan_name" Margin="0,20,0,0" HorizontalAlignment="Left"  VerticalAlignment="Top" FontWeight="Bold" FontSize="14"/>
        </StackPanel>

        <!-- ЛЕГЕНДА ТАБЛИЦЫ -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                Margin="20,0,20,0"
                Height="30"
                VerticalAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Label Content="название"
                       x:Name="Name"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#666666"
                       Padding="10,0"/>

                <Label Content="количество"
                       x:Name="Quantity"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#666666"
                       Padding="10,0"/>

                <Label Content="действия"
                       x:Name="Actions"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#666666"
                       Padding="10,0"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="20,30,20,36" x:Name="parent" />

        <Button Grid.Row="2" VerticalAlignment="Top" Margin="0,10,0,0" Width="150" Height="30" Click="goto_page_add_comp" Content="добавить" Style="{StaticResource MyButtonStyle}" Grid.RowSpan="2" />


    </Grid>
</Page>