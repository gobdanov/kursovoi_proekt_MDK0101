<Page x:Class="KAMA_PRO_CRUD_APP.pages.Page_Salary"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:KAMA_PRO_CRUD_APP.pages"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="487"
      Title="Page_Salary">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="150*"/>
            <RowDefinition Height="75*"/>
            <RowDefinition Height="75*"/>
            <RowDefinition Height="200*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216*"/>
            <ColumnDefinition Width="271*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.ColumnSpan="2" Grid.RowSpan="5">
            <Label Content="зарплата для пользователя вадим благовещенск" x:Name="salaryFor" HorizontalAlignment="Left" Margin="0,20,0,0" VerticalAlignment="Center" FontWeight="Bold" FontSize="14"/>
            <Label Content="за период 20.04.26-27.04.26" x:Name="salaryAt" HorizontalAlignment="Left" Margin="0,-5,0,0" VerticalAlignment="Top"/>
        </StackPanel>

        <Border Grid.Column="0" Margin="5,5,5,5" Grid.Row="1" CornerRadius="20" Background="#f0f0f0">
            <ScrollViewer Margin="0,0,15,0">
                <StackPanel Margin="10,0,0,0" x:Name="sdelka">
                    <Label Content="сделка:" FontWeight="Bold"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="0" Margin="5,5,5,5" Grid.Row="2" Background="#f0f0f0" CornerRadius="20">
            <StackPanel Margin="10,0,0,0">
                <Label Content="сделка:" FontWeight="Bold"/>
                <Label Content="0 ч"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="0" Margin="5,5,5,5" Grid.Row="3" Background="#f0f0f0" CornerRadius="20">
            <StackPanel Margin="10,0,0,0">
                <Label Content="итого:" FontWeight="Bold"/>
                <Label Content="3000р" x:Name="allSum"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Margin="5,5,5,5" Grid.Row="1" Grid.RowSpan="3" Background="#f0f0f0" CornerRadius="20">
            <ScrollViewer Margin="0,0,15,0">
                <StackPanel Margin="10,0,0,0">
                    <Label Content="прошлые выплаты:" FontWeight="Bold"/>
                    <Label Content="-"/>
                    <Label Content="-"/>
                    <Label Content="-"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
